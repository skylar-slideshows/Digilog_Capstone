	(text "IN low = SxB (power-up default):\nLINE_SEL_LCV  1 = line, 0 = mic\nHIZ_SEL_LCV   1 = Hi-Z (overrides)\nPHASE_LCV     1 = polarity reversed\nHPF_LCV       1 = 90 Hz HPF in\nAll low = mic, normal, HPF out."
		(exclude_from_sim no)
