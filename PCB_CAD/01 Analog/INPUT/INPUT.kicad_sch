	(text "DESIGN NOTES\n1. Power-up (all logic low, DAC EEPROM 0 V): mic input, +40 dB, normal polarity, HPF out, phantom off, VCA muted.\n2. Firmware mutes (DAC 0) for ~10 ms around PAD / select / polarity / HPF changes, ~1.5 s around P48 changes.\n3. K1: confirm COM = pins 3/6 against Omron internal-connection drawing before layout.\n4. U6 (AS2180) exposed pad: leave unconnected until confirmed in the Alfa datasheet.\n5. 0.1% thin film: R1/R2 (matched), R8, R9, R21-R24, R33, R36, R40-R44.  C0G: all <=100n non-polar."
		(exclude_from_sim no)
		(at 131.064 258.318 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "091431fb-dedb-4a46-b008-cb055b4737af")
	)
