	(text "J73 and J74 are identical 2x12 IDC headers wired pin for pin: ribbon in from one neighbour, out to the next.\nMIX bus is balanced stereo (MIX_L+/-, MIX_R+/-); AUX1-3 are stereo and AUX4 mono, single-ended.\nEvery bus line has a ground between it and the next signal in the ribbon. Pins 22-23 spare.\nStill to come: insert SEND (4) / RETURN (4), MASTER SPI (4)."
		(exclude_from_sim no)
		(at 425 22.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e0116243-9b5a-4041-94e3-0c686c361d1e")
	)
