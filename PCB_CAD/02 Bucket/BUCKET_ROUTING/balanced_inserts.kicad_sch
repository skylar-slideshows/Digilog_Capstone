	(text "CHANNEL 1 INSERT  (balanced send U13, balanced return U17, header J4)"
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1aa02068-f744-473f-8e5d-50e411c65284")
	)
	(text "Decoupling: place each cap at its pin (U14: C30/C31, U18: C32-C35)"
		(exclude_from_sim no)
		(at 360.68 146.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2f8f80ca-b038-4e37-a5aa-fc9f96c8948a")
	)
	(text "BALANCED INSERTS\nSend: the fader card INSERT_AUDIO_SEND (single-ended, op-amp driven) feeds a DRV135 (TI DRV134/135, +6 dB, 50 R outputs);\n+VO/+SENSE and -VO/-SENSE are tied at the IC, so the outputs are the balanced pair on header pins 1 (+) and 3 (-).\nReturn: header pins 5 (+) and 7 (-) feed an INA1651 (TI SoundPlus, 0 dB, 91 dB CMRR, -120 dB THD+N) through 10 uF DC blocks,\nwith 100k discharge resistors, COM to ground through 1M and REF tied straight to ground (split +/-15 V supply, VMID pins unused).\nGain: DRV135 +6 dB, INA1651 0 dB, so a 1k/1k (0.1%) pad after the INA1651 brings the insert loop back to unity.\nFor +6 dB loop gain fit the series pad resistor as 0R and leave the shunt open.\nHeader (per channel, 1x08 2.54 mm): 1 SEND+  2 GND  3 SEND-  4 GND  5 RTN+  6 GND  7 RTN-  8 GND.\nLayout: decoupling at the supply pins, REF straight to ground, route RTN+/RTN- (and SEND+/SEND-) as tight pairs over ground."
		(exclude_from_sim no)
		(at 25.4 370.84 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "38ecf4d8-9e34-406f-bae3-70d6f389296e")
	)
	(text "Decoupling: place each cap at its pin (U16: C46/C47, U20: C48-C51)"
