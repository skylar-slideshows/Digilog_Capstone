		)
	)
	(gr_text "You 100% may and SHOULD change the order of the pins on the connectors to make layout\neasiest and not crossing everywhere. Just keep it consistent across\nall buses and keep grounds checkerboarded in (for low Z return path for each)"
		(at 110.4 46.1 0)
		(layer "User.1")
		(uuid "389688a1-9571-44ad-952c-c7bbbdc499d9")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "I think a good layout would be to have the dacs straddling the line between\nanalog and digital, analog pins facing analog side, i2c 1 and 3 chip on top line,\ni2c 2 and 4 chips on bottom line."
		(at 112.1 32.52 0)
