			)
			(justify left top)
		)
		(uuid "ce39b1e9-2fac-4144-8709-b1af22adddaf")
	)
	(text "RV101 sets RLO (pin 4), ~50-75 mV, \nto cancel the detector idle offset.\nR13 + RV102 (2.2-3.2k, pin 8 to GND) set RHI.\nC8: pin 4 to pin 2 ground.\n\nCAL, 1 kHz sine, no DC offset:\n  0. RV103 brightness first (it loads REF slightly).\n  1. RV101: -20 dB lamp just on at 0.347 Vpp, off at idle.\n  2. RV102: 0 dB lamp just on at 3.474 Vpp.\n  3. Recheck 1."
		(exclude_from_sim no)
		(at 193.04 202.184 0)
