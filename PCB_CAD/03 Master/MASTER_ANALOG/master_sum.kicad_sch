	(text "MAIN MIX SUMMERS  (internal level -6 dB: +4 dBu bus = -2 dBu inside)"
		(exclude_from_sim no)
		(at 135.89 16.51 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a6dcd89d-da7b-4554-8629-b3b85cf04d84")
	)
	(text "NOTES\nBus nodes: 16 channels x 10k per line. Noise gain ~8.5 (mix, 4.70k) and ~9 (sends, 4.99k).\nMix: pan/fader OPA1637 legs = +/-1.068 V per volt (4.7k/2.2k). Summers 4.70k + difference x1/2\n  -> MIX_INT = 0.5 x channel (-6 dB internal). DRV135 (+6 dB) restores +4 dBu at the outputs.\nAux: summers -0.5 (4.99k; SEND3 2.49k for its two 10k feeds), inverters restore polarity.\nAux return VCAs inject into MIX_L+/MIX_R+ through ADG1436 (returns sheets).\nC(f) across each summer feedback for stability against bus/backplane capacitance."
		(exclude_from_sim no)
		(at 306 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a8d26608-3f86-4820-ab4b-4b97a8418da0")
	)
