				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "25abb36b-e68e-40b6-adca-3b63586cf4eb")
	)
	(text "CV IN (J4, 1.27 mm 2x10, same part and GND pattern as the routing board DAC headers)\n2 AUXRET1_CV, 3 AUXRET2_CV, 6 AUXRET1_MIX_LCV, 7 AUXRET2_MIX_LCV\n14 AUXRET3_CV, 15 AUXRET4_CV, 18 AUXRET3_MIX_LCV, 19 AUXRET4_MIX_LCV\nCVs 0-2.048 V (DAC), MIX_LCV 3.3 V logic (1 = return into the mix). 10/11 spare, all other pins GND"
		(exclude_from_sim no)
		(at 50.8 273.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "43412b5e-ba98-4841-b0de-1b7972e0cf97")
	)
	(text "9-source relay select, mono/dim/mute, pot header\nMON_OUT_L/R (DRV135), PHONES_L/R (OPA1622)"
